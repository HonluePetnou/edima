{
  "name": "edima-extension",
  "description": "Couche d'accessibilite linguistique pour les services financiers en ligne.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.7",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^2.1.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "edima-shared": "workspace:*",
    "preact": "^11.2.0"
  }
}
